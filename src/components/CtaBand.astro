---
import { site } from '../data/site';
const { title = 'Sprawdź, ile będzie kosztować Twój dom', text = `7 pytań, około minuty. Cenę zobaczysz od razu. Ostatnie wolne terminy realizacji: ${site.nextSlot}.` } = Astro.props;
---
<section class="bg-sun">
  <div class="wrap flex flex-col items-start gap-6 py-12 lg:flex-row lg:items-center lg:justify-between">
    <div><h2 class="text-2xl sm:text-3xl">{title}</h2><p class="mt-2 text-navy/80">{text}</p></div>
    <div class="flex flex-col gap-3 sm:flex-row"><a href="/wycena/" class="btn-dark">Poznaj cenę</a><a href={`tel:${site.phoneHref}`} class="btn-ghost">Zadzwoń: {site.phone}</a></div>
  </div>
</section>
