---
import { faq as all } from '../data/proof';
const { items = all } = Astro.props;
---
<div class="mx-auto grid max-w-3xl gap-3">
  {items.map((f: { q: string; a: string }) => (
    <details class="group rounded-xl border border-navy/10 bg-white p-5 open:shadow-sm">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-navy">{f.q}<span class="text-2xl leading-none text-ember transition group-open:rotate-45">+</span></summary>
      <p class="mt-3 text-mute">{f.a}</p>
    </details>
  ))}
</div>
