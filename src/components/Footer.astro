---
import { site } from '../data/site';
import { models, fullName } from '../data/models';
import { cities } from '../data/cities';
import { getCollection } from 'astro:content';
const { bare = false } = Astro.props;
const posts = (await getCollection('poradnik')).sort((a, b) => a.data.order - b.data.order);
const magnets = [
  { href: '/materialy/checklista-dzialki/', label: 'Checklista działki' },
  { href: '/materialy/katalog-z-cenami/', label: 'Katalog domów z cenami' },
  { href: '/materialy/formalnosci-krok-po-kroku/', label: 'Formalności krok po kroku' },
];
---
<footer class="bg-navy text-white/80">
  {!bare && (
    <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-sun">Domy i ceny</p>
        <ul class="mt-4 space-y-2 text-sm">
          {models.map((m) => <li><a class="hover:text-white" href={`/domy/${m.slug}/`}>{fullName(m)}</a></li>)}
          <li><a class="hover:text-white" href="/realizacje/">Realizacje</a></li>
          <li><a class="hover:text-white" href="/jak-to-dziala/">Jak to działa i gwarancja</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-wider text-sun">Poradnik</p>
        <ul class="mt-4 space-y-2 text-sm">
          {posts.map((p) => <li><a class="hover:text-white" href={`/poradnik/${p.id}/`}>{p.data.short}</a></li>)}
        </ul>
        <p class="mt-6 text-sm font-bold uppercase tracking-wider text-sun">Do pobrania</p>
        <ul class="mt-4 space-y-2 text-sm">
          {magnets.map((m) => <li><a class="hover:text-white" href={m.href}>{m.label}</a></li>)}
        </ul>
      </div>
      <div class="sm:col-span-2">
        <p class="text-sm font-bold uppercase tracking-wider text-sun">Domy modułowe w Twojej okolicy</p>
        <ul class="mt-4 columns-2 gap-6 text-sm sm:columns-3 [&>li]:mb-2">
          {cities.map((c) => <li><a class="hover:text-white" href={`/domy-modulowe/${c.slug}/`}>Domy modułowe {c.name}</a></li>)}
        </ul>
        <a class="mt-3 inline-block text-sm font-bold text-sun hover:underline" href="/domy-modulowe/">Wszystkie lokalizacje →</a>
      </div>
    </div>
  )}
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-3 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>{site.legalName} · NIP {site.nip} · {site.city}, {site.street}, {site.postal}</p>
      <p><a class="hover:text-white" href={`tel:${site.phoneHref}`}>{site.phone}</a> · <a class="hover:text-white" href={`mailto:${site.email}`}>{site.email}</a> · <a class="hover:text-white" href="/polityka-prywatnosci/">Polityka prywatności</a></p>
    </div>
  </div>
</footer>
