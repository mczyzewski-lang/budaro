---
import { site, zl, brutto } from '../data/site';
import { Image } from 'astro:assets';
import { img } from '../data/img';
interface Props { eyebrow?: string; title?: string; lead?: string; cta?: string; ctaHref?: string; image?: string; imageAlt?: string }
const {
  eyebrow = 'Całoroczne domy modułowe na zgłoszenie',
  title = `Twój dom w ${site.guarantee.days} dni. Albo płacimy ${site.guarantee.penalty} za każdy dzień opóźnienia.`,
  lead = `Dom z piętrem od ${zl(site.priceFrom)} netto (${zl(brutto(site.priceFrom))} brutto). W cenie formalności, fundament, transport i montaż.`,
  cta = 'Sprawdź cenę swojego domu', ctaHref = '/wycena/', image = 'img/hero-house-reference', imageAlt = 'Nowoczesny dom modułowy Budaro z dużym przeszkleniem',
} = Astro.props;
---
<section class="relative overflow-hidden bg-gradient-to-b from-sun-100/60 to-white">
  <div class="wrap grid items-center gap-10 py-10 sm:py-16 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-3 text-4xl leading-[1.08] sm:text-5xl lg:text-[3.4rem]">{title}</h1>
      <p class="mt-5 max-w-xl text-lg text-ink">{lead}</p>
      <ul class="mt-5 grid gap-2 text-base font-semibold text-navy">
        <li class="tick">Stała cena zapisana w umowie</li>
        <li class="tick">Formalności od A do Z po naszej stronie</li>
        <li class="tick">{site.stats.warrantyYears} lat gwarancji na konstrukcję</li>
      </ul>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={ctaHref} class="btn-primary !px-7 !py-4 !text-lg lg:whitespace-nowrap">{cta} →</a>
        <a href={`tel:${site.phoneHref}`} class="btn-ghost whitespace-nowrap">Zadzwoń: {site.phone}</a>
      </div>
      <p class="mt-4 text-sm text-mute"><span class="font-bold text-sun-600">★★★★★</span> {site.stats.rating} w Google · {site.stats.houses} zrealizowanych domów · 7 pytań, cena od razu na ekranie</p>
    </div>
    <div class="relative">
      <slot name="media"><Image src={img(image)} alt={imageAlt} widths={[480, 800, 1200]} sizes="(max-width: 1024px) 100vw, 540px" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full rounded-3xl object-cover shadow-2xl" /></slot>
      <div class="absolute -bottom-4 left-4 rounded-2xl bg-navy px-5 py-3 text-white shadow-xl sm:left-6">
        <p class="text-xs font-semibold text-white/70">Gwarancja terminu w umowie</p>
        <p class="text-lg font-extrabold text-sun">{site.guarantee.days} dni albo {site.guarantee.penalty}/dzień</p>
      </div>
    </div>
  </div>
</section>
