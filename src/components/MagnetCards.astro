---
import { magnets, stages, type Stage } from '../data/magnets';
interface Props { featured?: boolean; grouped?: boolean }
const { featured = false, grouped = false } = Astro.props;
const all = Object.entries(magnets).map(([slug, m]) => ({ slug, ...m }));
const groups: { key: string; title?: string; lead?: string; items: typeof all }[] = grouped
  ? (Object.keys(stages) as Stage[]).map((s) => ({ key: s, ...stages[s], items: all.filter((m) => m.stage === s) }))
  : [{ key: 'all', items: featured ? all.filter((m) => m.featured) : all }];
---
{groups.map((g) => (
  <div class:list={[grouped && 'mt-12 first:mt-0']}>
    {g.title && <><h2 class="text-2xl">{g.title}</h2><p class="mt-1 text-mute">{g.lead}</p></>}
    <div class:list={['grid gap-5 md:grid-cols-3', g.title && 'mt-5']}>
      {g.items.map((m) => (
        <a href={`/materialy/${m.slug}/`} class="card group flex flex-col transition hover:border-ember hover:shadow-lg">
          <span class="chip self-start">PDF · bezpłatnie</span>
          <p class="mt-3 text-lg font-extrabold text-navy group-hover:text-ember">{m.title}</p>
          <p class="mt-2 text-sm text-mute">{m.pitch}</p>
          <span class="mt-auto pt-4 font-bold text-ember">Pobierz →</span>
        </a>
      ))}
    </div>
  </div>
))}
