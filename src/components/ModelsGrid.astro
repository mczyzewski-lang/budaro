---
import { models, fullName } from '../data/models';
import { zl, brutto } from '../data/site';
import { Image } from 'astro:assets';
import { img } from '../data/img';
const { heading = 'h3' } = Astro.props;
const H = heading;
---
<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {models.map((m) => (
    <article class="group flex flex-col overflow-hidden rounded-2xl border border-navy/10 bg-white shadow-sm transition hover:shadow-lg">
      <a href={`/domy/${m.slug}/`} class="block overflow-hidden"><Image src={img('modele/' + m.images[0])} alt={`Dom modułowy ${fullName(m)}`} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 400px" class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105" /></a>
      <div class="flex flex-1 flex-col p-5">
        <span class="chip self-start">{m.permit} · na zgłoszenie</span>
        <H class="mt-3 text-xl"><a href={`/domy/${m.slug}/`} class="hover:text-ember">{fullName(m)}</a></H>
        <p class="mt-1 text-sm text-mute">{m.tagline}</p>
        <dl class="mt-4 grid grid-cols-2 gap-2 text-sm">
          <div><dt class="text-mute">Pow. użytkowa</dt><dd class="font-bold text-navy">{m.usable}</dd></div>
          <div><dt class="text-mute">Pomieszczenia</dt><dd class="font-bold text-navy">{m.rooms}</dd></div>
        </dl>
        <div class="mt-auto pt-5">
          <p class="text-xl font-extrabold text-navy">od {zl(m.priceFrom)} <span class="text-sm font-semibold text-mute">netto</span></p>
          <p class="text-xs text-mute">{zl(brutto(m.priceFrom))} brutto z 8% VAT · z fundamentem i montażem</p>
          <a href={`/domy/${m.slug}/`} class="btn-dark mt-4 w-full !py-3">Zobacz projekt i rzuty</a>
        </div>
      </div>
    </article>
  ))}
  <article class="flex flex-col justify-center rounded-2xl bg-sun p-7">
    <p class="text-2xl font-extrabold text-navy">Nie wiesz, który wybrać?</p>
    <p class="mt-2 text-navy/80">Odpowiedz na 7 pytań. Dobierzemy model i od razu pokażemy cenę.</p>
    <a href="/wycena/" class="btn-dark mt-5 self-start">Dobierz dom i poznaj cenę</a>
  </article>
</div>
