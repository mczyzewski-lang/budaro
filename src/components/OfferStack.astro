---
import { site, zl, brutto } from '../data/site';
const { href = '/wycena/' } = Astro.props;
const core = [
  ['Projekt i komplet formalności', 'Dokumentacja, geodeta, badania gruntu i zgłoszenie w urzędzie. Ty podpisujesz, my załatwiamy.'],
  ['Płyta fundamentowa', 'Zaprojektowana pod Twój grunt i wykonana przez naszą ekipę.'],
  ['Dom wyprodukowany w hali', 'Konstrukcja z certyfikowanego drewna, dach, okna, drzwi wejściowe i elewacja.'],
  ['Transport i montaż w całej Polsce', 'Dowozimy i stawiamy dom w 3–4 dni. Bez dopłaty za kilometry.'],
];
const bonus = [
  ['Bezpłatna ocena działki przed zakupem', 'Wysyłasz numer działki lub ogłoszenie, mówimy, czy stanie na niej dom na zgłoszenie.'],
  ['Pomoc w kredycie', 'Kosztorys i harmonogram na drukach banku, kontakt do doradcy znającego domy modułowe.'],
  ['Panel klienta', 'Postęp formalności i budowy sprawdzasz online, bez dzwonienia.'],
  ['Niezależny odbiór', 'Dom sprawdza zewnętrzna firma odbiorowa, zanim podpiszesz protokół.'],
];
---
<section class="section bg-sand">
  <div class="wrap">
    <p class="eyebrow">Oferta</p>
    <h2 class="h2">Jedna umowa. Jedna cena. Wszystko, czego potrzeba, żeby dom stanął.</h2>
    <div class="mt-8 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
      <div class="grid gap-3">
        {core.map(([t, d]) => <div class="flex gap-4 rounded-2xl border border-navy/10 bg-white p-5"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-600 font-extrabold text-white">✓</span><div><p class="font-extrabold text-navy">{t}</p><p class="text-sm text-mute">{d}</p></div></div>)}
        <p class="mt-3 text-sm font-bold uppercase tracking-wider text-ember">W cenie dostajesz też</p>
        {bonus.map(([t, d]) => <div class="flex gap-4 rounded-2xl border border-dashed border-sun-600 bg-sun-100/60 p-5"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-sun font-extrabold text-navy">+</span><div><p class="font-extrabold text-navy">{t}</p><p class="text-sm text-mute">{d}</p></div></div>)}
      </div>
      <aside class="self-start rounded-3xl bg-navy p-7 text-white lg:sticky lg:top-24">
        <p class="text-sm font-semibold text-white/70">Wszystko powyżej w jednej cenie</p>
        <p class="mt-1 text-4xl font-extrabold text-sun">od {zl(site.priceFrom)}</p>
        <p class="text-sm text-white/70">netto · {zl(brutto(site.priceFrom))} brutto z 8% VAT</p>
        <ul class="mt-5 grid gap-2.5 text-sm font-semibold">
          <li class="tick">Cena stała, zapisana w umowie</li>
          <li class="tick">{site.guarantee.days} dni albo {site.guarantee.penalty} za każdy dzień</li>
          <li class="tick">{site.stats.warrantyYears} lat gwarancji na konstrukcję</li>
        </ul>
        <a href={href} class="btn-primary mt-6 w-full">Sprawdź cenę swojego domu →</a>
        <p class="mt-3 text-center text-xs font-semibold text-sun">Ostatnie wolne terminy realizacji: {site.nextSlot}</p>
      </aside>
    </div>
  </div>
</section>
