---
import { videoTestimonials } from '../data/proof';
import { Image } from 'astro:assets';
import { img } from '../data/img';
const { limit = 6, woj = '' } = Astro.props;
// opinie z danego województwa idą na początek
const list = [...videoTestimonials].sort((a, b) => Number(b.woj === woj) - Number(a.woj === woj)).slice(0, limit);
---
<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
  {list.map((v) => (
    <figure class="overflow-hidden rounded-2xl border border-navy/10 bg-white shadow-sm">
      <button type="button" data-vimeo={v.id} data-title={`Opinia: ${v.name}`} data-ratio="9/16" class="group relative block aspect-[4/5] w-full cursor-pointer overflow-hidden bg-navy" aria-label={`Odtwórz opinię wideo: ${v.name}`}>
        <Image src={img(`opinie/vimeo-${v.id}-pion`)} alt="" widths={[400, 640]} sizes="(max-width: 640px) 100vw, 380px" class="h-full w-full object-cover transition group-hover:scale-105" style={`object-position:${v.pos}`} />
        <span class="absolute inset-0 m-auto flex h-14 w-14 items-center justify-center rounded-full bg-sun text-navy shadow-xl"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor"><path d="M6 4l11 6-11 6z"/></svg></span>
      </button>
      <blockquote class="p-5">
        <p class="font-semibold text-navy">„{v.quote}”</p>
        <figcaption class="mt-2 text-sm text-mute"><span class="font-bold text-navy">{v.name}</span>{v.region && <span class="block">{v.region}</span>}</figcaption>
      </blockquote>
    </figure>
  ))}
</div>
