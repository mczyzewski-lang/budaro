---
import Base from '../../layouts/Base.astro';
import ModelsGrid from '../../components/ModelsGrid.astro';
import VideoTestimonials from '../../components/VideoTestimonials.astro';
import Guarantee from '../../components/Guarantee.astro';
import Faq from '../../components/Faq.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gallery from '../../components/Gallery.astro';
import { cities, roadKmFromFactory, nearbyCities, cityNearest, type Urzad } from '../../data/cities';
import { site, zl, brutto } from '../../data/site';
export function getStaticPaths() { return cities.map((c) => ({ params: { miasto: c.slug }, props: { c } })); }
const { c } = Astro.props;
const dist = roadKmFromFactory(c);
const near = cityNearest(c);
const here = near.km <= 5;
const nearby = nearbyCities(c);
const days = dist <= 350 ? 'w ciągu jednego dnia' : 'zwykle w ciągu jednego do dwóch dni';
const urzadLine = (u: Urzad) => [u.nazwa, u.wydzial, u.adres].filter(Boolean).join(', ');
const faq = [
  { q: `Ile kosztuje dom modułowy ${c.loc}?`, a: `Ceny są takie same w całej Polsce i zaczynają się od ${zl(site.priceFrom)} netto (${zl(brutto(site.priceFrom))} brutto). Transport z naszej hali w Gowarzewie ${c.loc === 'w Poznaniu' ? 'pod Poznaniem' : `do ${c.gen}`}, około ${dist} km, jest wliczony w cenę.` },
  { q: `Gdzie złożyć zgłoszenie budowy domu do 70 m² ${c.loc} i okolicach?`, a: c.grodzkie
      ? `Dla działki w granicach miasta: ${urzadLine(c.miasto!)}. Dla działki w gminach ościennych (${c.powiat.gminy.slice(0, 4).join(', ')}): ${urzadLine(c.powiat.urzad)}. Dokumenty przygotowuje i składa nasz architekt.`
      : `${c.name} leży w powiecie ${c.powiat.nazwa.replace('powiat ', '')}, więc zgłoszenie przyjmuje ${urzadLine(c.powiat.urzad)}. Dokumenty przygotowuje i składa nasz architekt.` },
  { q: `Czy budowaliście już w okolicy ${c.gen}?`, a: here
      ? `Tak, postawiliśmy dom Modern ${near.model} ${near.loc}. Zdjęcia znajdziesz w realizacjach.`
      : `Najbliższa realizacja ze zdjęciami na naszej stronie to Modern ${near.model} ${near.loc}, około ${near.km} km od ${c.gen} w linii prostej. Łącznie zrealizowaliśmy ${site.stats.houses} domów w całej Polsce.` },
  { q: `Jak szybko postawicie dom ${c.pod}?`, a: `Tak samo jak wszędzie: ${site.guarantee.days} dni od skompletowania formalności albo ${site.guarantee.penalty} za każdy dzień opóźnienia. Sam montaż na działce trwa 3–4 dni.` },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['Lokalizacje', '/domy-modulowe/'], [c.name, `/domy-modulowe/${c.slug}/`]].map(([n, u], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: site.url + u })) };
const service = { '@context': 'https://schema.org', '@type': 'Service', name: `Budowa domów modułowych ${c.name}`, provider: { '@type': 'Organization', name: site.name, url: site.url }, areaServed: { '@type': 'City', name: c.name }, offers: { '@type': 'Offer', priceCurrency: 'PLN', price: brutto(site.priceFrom) } };
// inne zdjęcia na każdej stronie, deterministycznie
const seed = [...c.slug].reduce((s, ch) => s + ch.charCodeAt(0), 0);
const pool = [2, 3, 6, 8, 9, 12, 13, 14, 16, 18, 23, 26, 27, 28, 32, 33, 40, 42, 47, 48, 49];
const pics = Array.from({ length: 4 }, (_, i) => pool[(seed + i * 5) % pool.length]);
---
<Base title={`Domy modułowe ${c.name}: ceny od ${zl(site.priceFrom)}, ${site.guarantee.days} dni | Budaro`} description={`Całoroczne domy modułowe ${c.loc} i okolicach. Od ${zl(site.priceFrom)} netto z fundamentem, transportem (ok. ${dist} km) i montażem. Najbliższa realizacja: ${near.place}.`} jsonld={[faqLd, crumbs, service]}>
  <section class="bg-gradient-to-b from-sun-100/60 to-white"><div class="wrap py-10 sm:py-16">
    <nav class="text-sm text-mute" aria-label="Okruszki"><a href="/domy-modulowe/" class="hover:text-ember">Lokalizacje</a> / <span class="text-navy">{c.name}</span></nav>
    <h1 class="mt-4 max-w-4xl text-4xl sm:text-5xl">Domy modułowe {c.name}: gotowe w {site.guarantee.days} dni od formalności</h1>
    <p class="mt-5 max-w-3xl text-lg text-ink">Całoroczny dom z piętrem {c.loc} lub {c.pod}, od {zl(site.priceFrom)} netto. W cenie formalności, płyta fundamentowa, transport z naszej hali (ok. {dist} km) i montaż. Za każdy dzień opóźnienia płacimy {site.guarantee.penalty}.</p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row"><a href="/wycena/" class="btn-primary !px-7 !py-4 !text-lg">Sprawdź cenę swojego domu →</a><a href={`tel:${site.phoneHref}`} class="btn-ghost">Zadzwoń: {site.phone}</a></div>
    <dl class="mt-10 grid gap-4 sm:grid-cols-3">
      <div class="card"><dt class="text-sm text-mute">Najbliższa realizacja</dt><dd class="mt-1 text-xl font-extrabold text-navy">{here ? `${near.place}, na miejscu` : `${near.place}, ok. ${near.km} km`}</dd><dd class="text-sm text-mute">Modern {near.model}{!here && ', w linii prostej'}</dd></div>
      <div class="card"><dt class="text-sm text-mute">Transport z hali w Gowarzewie</dt><dd class="mt-1 text-xl font-extrabold text-navy">ok. {dist} km</dd><dd class="text-sm text-mute">w cenie domu, {days}</dd></div>
      <div class="card"><dt class="text-sm text-mute">Zgłoszenie składa się w</dt><dd class="mt-1 text-xl font-extrabold text-navy">{c.grodzkie ? 'urzędzie miasta lub starostwie' : c.powiat.urzad.nazwa.replace('Starostwo Powiatowe', 'starostwie')}</dd><dd class="text-sm text-mute">zależnie od położenia działki</dd></div>
    </dl>
  </div></section>

  <section class="section"><div class="wrap grid gap-10 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="eyebrow">Formalności lokalnie</p>
      <h2 class="h2">Gdzie załatwia się formalności {c.loc} i okolicach</h2>
      <p class="mt-4 text-ink">Zgłoszenie budowy domu do 70 m² zabudowy przyjmuje organ administracji architektoniczno-budowlanej właściwy dla <strong>położenia działki</strong>, a nie Twojego adresu.</p>
      <div class="mt-6 grid gap-4">
        {c.grodzkie && c.miasto && (
          <div class="card"><p class="text-sm font-bold text-ember">Działka w granicach {c.gen}</p><p class="mt-1 text-lg font-extrabold text-navy">{c.miasto.nazwa}</p>{c.miasto.wydzial && <p class="text-sm text-ink">{c.miasto.wydzial}</p>}{c.miasto.adres && <p class="text-sm text-mute">{c.miasto.adres}</p>}</div>
        )}
        <div class="card"><p class="text-sm font-bold text-ember">{c.grodzkie ? `Działka ${c.pod}, ${c.powiat.nazwa}` : `${c.name} i ${c.powiat.nazwa}`}</p><p class="mt-1 text-lg font-extrabold text-navy">{c.powiat.urzad.nazwa}</p>{c.powiat.urzad.wydzial && <p class="text-sm text-ink">{c.powiat.urzad.wydzial}</p>}{c.powiat.urzad.adres && <p class="text-sm text-mute">{c.powiat.urzad.adres}</p>}<p class="mt-3 text-sm text-ink">Gminy: {c.powiat.gminy.join(', ')}.</p></div>
        {c.inne && <p class="text-sm text-mute">Klienci z okolic {c.gen} kupują też działki w powiatach: {c.inne.join(', ')}. Tam zgłoszenie trafia do starostwa danego powiatu.</p>}
      </div>
      <p class="mt-4 text-xs text-mute">Dane urzędów podajemy orientacyjnie. Aktualny adres i godziny przyjęć sprawdź na stronie urzędu. Dokumenty i tak składa nasz architekt.</p>
    </div>
    <div class="grid content-start gap-5">
      {c.tip && <div class="rounded-2xl bg-navy p-6 text-white"><p class="text-sm font-bold uppercase tracking-wider text-sun">Warto wiedzieć: {c.name}</p><p class="mt-2 text-white/85">{c.tip}</p></div>}
      <div class="card"><h3 class="text-lg">Co robimy za Ciebie</h3><ul class="mt-3 grid gap-2 text-sm"><li class="tick">Sprawdzenie planu miejscowego lub wniosek o warunki zabudowy</li><li class="tick">Mapa do celów projektowych i badania gruntu</li><li class="tick">Adaptacja projektu do działki</li><li class="tick">Złożenie zgłoszenia w urzędzie</li></ul><a href="/poradnik/dom-na-zgloszenie-do-70-m2/" class="mt-4 inline-block text-sm font-bold text-ember hover:underline">Jak działa zgłoszenie domu do 70 m² →</a></div>
    </div>
  </div></section>

  <section class="section bg-sand"><div class="wrap">
    <p class="eyebrow">Projekty i ceny</p>
    <h2 class="h2">Domy, które postawimy {c.loc}</h2>
    <p class="lead max-w-2xl">Ceny z transportem {c.name === 'Poznań' ? 'pod Poznań' : `do ${c.gen}`} i montażem.</p>
    <div class="mt-8"><ModelsGrid heading="h3" /></div>
  </div></section>

  <section class="section"><div class="wrap">
    <p class="eyebrow">Realizacje</p>
    <h2 class="h2">{here ? `Budowaliśmy już ${c.loc}` : `Najbliżej ${c.gen} budowaliśmy ${near.loc}`}</h2>
    <p class="lead max-w-2xl">{here ? `Dom Modern ${near.model} ${near.loc} to jedna z naszych ${site.stats.houses} realizacji.` : `Modern ${near.model} ${near.loc}, około ${near.km} km od ${c.gen}. Poniżej zdjęcia z naszych budów.`}</p>
    <div class="mt-8"><Gallery ids={pics} alt={`Dom modułowy Budaro, realizacja`} /></div>
    <div class="mt-10"><VideoTestimonials limit={3} woj={c.woj} /></div>
  </div></section>

  <Guarantee />

  <section class="section"><div class="wrap">
    <h2 class="h2 text-center">Pytania o budowę {c.loc}</h2>
    <div class="mt-8"><Faq items={faq} /></div>
    <div class="mx-auto mt-12 max-w-3xl"><LeadMagnet slug="formalnosci-krok-po-kroku" /></div>
  </div></section>

  <section class="section bg-sand"><div class="wrap">
    <h2 class="text-2xl">Budujemy też w pobliżu</h2>
    <ul class="mt-5 flex flex-wrap gap-2">
      {nearby.map((n) => <li><a href={`/domy-modulowe/${n.slug}/`} class="rounded-full border border-navy/15 bg-white px-4 py-2 text-sm font-semibold text-navy hover:border-ember">Domy modułowe {n.name}</a></li>)}
      <li><a href="/domy-modulowe/" class="px-3 py-2 text-sm font-bold text-ember">Wszystkie lokalizacje →</a></li>
    </ul>
  </div></section>
  <CtaBand title={`Sprawdź cenę domu ${c.loc}`} />
</Base>
