---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ProofBar from '../../components/ProofBar.astro';
import ModelsGrid from '../../components/ModelsGrid.astro';
import Guarantee from '../../components/Guarantee.astro';
import VideoTestimonials from '../../components/VideoTestimonials.astro';
import Quiz from '../../components/Quiz.astro';
import Faq from '../../components/Faq.astro';
import { site, zl, brutto } from '../../data/site';
---
<!-- Landing pod Google Ads: ruch z intencją. Kolejność: cena i termin → dowód → modele z cenami → quiz. -->
<Base title={`Dom modułowy od ${zl(site.priceFrom)} w 90 dni | Budaro`} description="Całoroczny dom modułowy ze stałą ceną i gwarancją terminu. Sprawdź cenę w minutę." bare noindex>
  <Hero eyebrow="Domy modułowe całoroczne · na zgłoszenie" title={`Dom modułowy od ${zl(site.priceFrom)} netto. Gotowy w ${site.guarantee.days} dni.`}
    lead={`${zl(brutto(site.priceFrom))} brutto z formalnościami, fundamentem, transportem i montażem. Jeśli spóźnimy się z terminem, płacimy ${site.guarantee.penalty} za każdy dzień.`} cta="Sprawdź cenę dla swojej działki" ctaHref="#quiz" />
  <ProofBar />
  <section class="section" id="domy"><div class="wrap">
    <h2 class="h2">Pięć domów. Każdy z ceną.</h2>
    <p class="lead max-w-2xl">Ceny netto za pakiet Podstawowy. Wszystkie domy stawiamy bez pozwolenia na budowę.</p>
    <div class="mt-8"><ModelsGrid /></div>
  </div></section>
  <Guarantee />
  <section class="section"><div class="wrap"><h2 class="h2">Klienci o współpracy</h2><div class="mt-8"><VideoTestimonials limit={3} /></div></div></section>
  <section class="section bg-navy"><div class="wrap">
    <h2 class="text-center text-3xl !text-white sm:text-4xl">Sprawdź cenę swojego domu</h2>
    <p class="mx-auto mt-3 max-w-xl text-center text-white/75">7 pytań, około minuty. Cenę zobaczysz od razu na ekranie.</p>
    <div class="mt-8"><Quiz source="lp-google" /></div>
  </div></section>
  <section class="section"><div class="wrap"><h2 class="h2 text-center">Najczęstsze pytania</h2><div class="mt-8"><Faq /></div></div></section>
</Base>
