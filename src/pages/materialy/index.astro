---
import Base from '../../layouts/Base.astro';
import MagnetCards from '../../components/MagnetCards.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<Base title="Bezpłatne materiały o domach modułowych | Budaro" description="Checklisty, arkusz budżetu, pytania do wykonawcy, katalog z cenami i przewodnik po formalnościach. Bezpłatne PDF-y dla planujących budowę domu modułowego.">
  <section class="section"><div class="wrap">
    <p class="eyebrow">Do pobrania</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Materiały, które oszczędzą Ci błędów</h1>
    <p class="lead max-w-2xl">Dziewięć krótkich PDF-ów ułożonych według tego, na jakim etapie jesteś. Każdy do wydrukowania i wypełnienia.</p>
    <div class="mt-10"><MagnetCards grouped /></div>
  </div></section>
  <CtaBand />
</Base>
