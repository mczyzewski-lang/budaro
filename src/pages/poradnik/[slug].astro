---
import Base from '../../layouts/Base.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import PostCards from '../../components/PostCards.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { img } from '../../data/img';
import { site } from '../../data/site';
import { cities } from '../../data/cities';
export async function getStaticPaths() { return (await getCollection('poradnik')).map((p) => ({ params: { slug: p.id }, props: { p } })); }
const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;
const ld = { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, dateModified: d.updated, datePublished: d.updated,
  author: { '@type': 'Person', name: d.author }, publisher: { '@type': 'Organization', name: site.name }, image: new URL(img(d.cover).src, site.url).href, mainEntityOfPage: `${site.url}/poradnik/${p.id}/` };
---
<Base title={`${d.title} | Budaro`} description={d.description} jsonld={[ld]} ogImage={img(d.cover).src}>
  <article class="wrap max-w-3xl py-10 sm:py-14">
    <nav class="text-sm text-mute" aria-label="Okruszki"><a href="/poradnik/" class="hover:text-ember">Poradnik</a> / <span class="text-navy">{d.short}</span></nav>
    <h1 class="mt-4 text-3xl sm:text-5xl">{d.title}</h1>
    <p class="mt-4 text-sm text-mute">{d.author}, Budaro · aktualizacja {new Date(d.updated).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })} · {d.readMin} min czytania</p>
    <Image src={img(d.cover)} alt="" widths={[640, 1000, 1400]} sizes="(max-width: 800px) 100vw, 768px" loading="eager" class="mt-8 aspect-[16/9] w-full rounded-3xl object-cover" />
    <div class="prose prose-lg mt-8 max-w-none prose-headings:font-extrabold prose-headings:text-navy prose-a:font-semibold prose-a:text-ember prose-th:text-navy"><Content /></div>
    <div class="mt-10"><LeadMagnet slug={d.magnet} /></div>
  </article>
  <section class="section bg-sand"><div class="wrap">
    <h2 class="text-2xl">Czytaj dalej</h2>
    <div class="mt-6"><PostCards limit={3} exclude={p.id} /></div>
    <h2 class="mt-12 text-2xl">Budujemy w Twojej okolicy</h2>
    <ul class="mt-4 flex flex-wrap gap-2">{cities.slice(0, 12).map((c) => <li><a href={`/domy-modulowe/${c.slug}/`} class="rounded-full border border-navy/15 bg-white px-3 py-1.5 text-sm font-semibold text-navy hover:border-ember">{c.name}</a></li>)}<li><a href="/domy-modulowe/" class="px-3 py-1.5 text-sm font-bold text-ember">Wszystkie →</a></li></ul>
  </div></section>
  <CtaBand />
</Base>
