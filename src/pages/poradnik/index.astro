---
import Base from '../../layouts/Base.astro';
import PostCards from '../../components/PostCards.astro';
import MagnetCards from '../../components/MagnetCards.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<Base title="Poradnik: domy modułowe, formalności, koszty | Budaro" description="Artykuły eksperckie o domach modułowych: formalności dla domu do 70 m², koszty, działka, kredyt i harmonogram budowy.">
  <section class="section"><div class="wrap">
    <p class="eyebrow">Poradnik</p>
    <h1 class="mt-2 text-4xl sm:text-5xl">Wiedza, zanim podpiszesz umowę</h1>
    <p class="lead max-w-2xl">Piszemy to, co mówimy klientom na pierwszej rozmowie. Konkretnie, z liczbami.</p>
    <div class="mt-10"><PostCards /></div>
    <h2 class="mt-16 text-2xl">Materiały do pobrania</h2>
    <div class="mt-6"><MagnetCards featured /></div>
    <a href="/materialy/" class="mt-6 inline-block font-bold text-ember hover:underline">Wszystkie materiały do pobrania →</a>
  </div></section>
  <CtaBand />
</Base>
