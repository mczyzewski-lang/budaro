---
import Base from '../layouts/Base.astro';
import Quiz from '../components/Quiz.astro';
import { site } from '../data/site';
---
<Base title="Wycena domu modułowego w minutę | Budaro" description="Odpowiedz na 7 pytań i od razu zobacz cenę dopasowanego domu modułowego. Z fundamentem, transportem i montażem." bare noindex>
  <section class="min-h-[80vh] bg-gradient-to-b from-navy to-navy-700 py-8 sm:py-14">
    <div class="wrap">
      <h1 class="text-center text-3xl !text-white sm:text-4xl">Sprawdź cenę swojego domu</h1>
      <p class="mx-auto mt-3 max-w-xl text-center text-white/75">7 pytań, około minuty. Cenę zobaczysz od razu na ekranie.</p>
      <div class="mt-8"><Quiz /></div>
      <ul class="mx-auto mt-8 flex max-w-2xl flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold text-white/80">
        <li>★ {site.stats.rating} w Google</li><li>{site.stats.houses} domów</li><li>{site.guarantee.short}</li>
      </ul>
    </div>
  </section>
</Base>
